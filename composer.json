{
    "name": "jgalea/eu-vat-handling-for-edd",
    "description": "Decides, applies and records EU VAT treatment on every Easy Digital Downloads order.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "mralaminahamed/easy-digital-downloads-stubs": "^3.7",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "VatrightEdd\\": "src/"
        }
    },
    "scripts": {
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --bootstrap tests/bootstrap-integration.php --testsuite integration",
        "lint": "phpcs",
        "stan": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "classmap-authoritative": true,
        "platform": {
            "php": "7.4"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
